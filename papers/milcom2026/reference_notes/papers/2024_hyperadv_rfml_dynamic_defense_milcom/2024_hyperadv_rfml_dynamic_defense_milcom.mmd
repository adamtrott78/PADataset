\title{
HyperAdv: Dynamic Defense Against Adversarial Radio Frequency Machine Learning Systems
}

\author{
Milin Zhang \({ }^{\times}\), Michael De Lucia \({ }^{\ddagger}\), Ananthram Swami \({ }^{\ddagger}\), Jonathan Ashdown*, Kurt Turck* and Francesco Restuccia \({ }^{\times}\) \\ \({ }^{\ddagger}\) DEVCOM Army Research Laboratory, United States \\ * Air Force Research Laboratory, United States \\ \({ }^{\times}\)Institute for the Wireless Internet of Things, Northeastern University, United States
