\title{
Energy-Based Open-World Uncertainty Modeling for Confidence Calibration
}

\author{
Yezhen Wang \({ }^{1 *}\) Bo Li \({ }^{1 *}\) Tong Che \({ }^{2 *}\) Kaiyang Zhou \({ }^{3}\) Ziwei Liu \({ }^{3}\) Dongsheng Li \({ }^{1}\) \\ \({ }^{1}\) Microsoft Research Asia \({ }^{2}\) MILA \({ }^{3}\) S-Lab, Nanyang Technological University
