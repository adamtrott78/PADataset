{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://padataset.local/scientific-request.v1.schema.json",
  "title": "PADataset scientific request v1",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "operation",
        "dataset_profile"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "operation": {
          "const": "smoke"
        },
        "dataset_profile": {
          "const": "ota_core_high_run01_len16384_v1"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "operation",
        "dataset_profile",
        "config_path"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "operation": {
          "enum": [
            "train_backbone",
            "stage03_archc"
          ]
        },
        "dataset_profile": {
          "const": "ota_core_high_run01_len16384_v1"
        },
        "config_path": {
          "type": "string",
          "pattern": "^manifests/configs/[A-Za-z0-9_./-]+\\.json$"
        }
      }
    }
  ],
  "$comment": "Candidate SHA is bound independently by the issue-comment trigger and exact open same-repository PR head; it is intentionally not repeated inside candidate-controlled request content."
}
