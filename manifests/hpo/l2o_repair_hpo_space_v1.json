{
  "schema": "padataset.l2o-repair-hpo-space.v1",
  "purpose": "Known-only HPO for corrected L2O cells that fail the baseline validation competency gate.",
  "eligibility": {
    "trigger": "baseline val_macro_f1 < 0.95 OR val_min_class_f1 < 0.90",
    "target_labels_allowed": false,
    "test_metrics_allowed_for_selection": false
  },
  "objective": {
    "primary": "val_macro_f1",
    "secondary": "val_min_class_f1",
    "promotion_rule": "lexicographic primary macro-F1, then minimum class F1; configurations below 0.90 minimum class F1 cannot win if any feasible configuration exists."
  },
  "search_space": {
    "lr": {
      "type": "log_float",
      "low": 0.00005,
      "high": 0.001
    },
    "weight_decay": {
      "type": "categorical",
      "values": [
        0,
        0.00001,
        0.0001,
        0.001
      ]
    },
    "lambda_center": {
      "type": "categorical",
      "values": [
        0,
        0.05,
        0.1,
        0.2
      ]
    },
    "label_smoothing": {
      "type": "categorical",
      "values": [
        0,
        0.05,
        0.1,
        0.15
      ]
    },
    "entropy_loss_weight": {
      "type": "categorical",
      "values": [
        0,
        0.01,
        0.05,
        0.1
      ]
    },
    "mlp_dropout": {
      "type": "categorical",
      "values": [
        0.2,
        0.3,
        0.4,
        0.5
      ]
    },
    "grad_clip_norm": {
      "type": "categorical",
      "values": [
        null,
        0.5,
        1,
        2
      ]
    },
    "scheduler_name": {
      "type": "categorical",
      "values": [
        "cosine",
        "plateau"
      ]
    },
    "batch_size": {
      "type": "categorical",
      "values": [
        8,
        16
      ]
    }
  },
  "resource_ladder": [
    {
      "stage": "screen",
      "max_trials": 96,
      "epochs": 8,
      "promote_top": 24
    },
    {
      "stage": "refine",
      "max_trials": 24,
      "epochs": 24,
      "promote_top": 6
    },
    {
      "stage": "finalist",
      "max_trials": 6,
      "epochs": 60,
      "promote_top": 1
    }
  ],
  "invariants": {
    "cache_len": 16384,
    "split_mode": "open_pa",
    "open_val_frac": 0,
    "early_stopping_mode": "known_only",
    "quarantine_target_until_test": true,
    "deterministic_training": true,
    "deterministic_profile": "strict_tf32",
    "topology": "same target/surrogate/three-known identities as failed baseline cell"
  },
  "notes": [
    "The ladder is intended to avoid 96 full 60-epoch runs per failed cell.",
    "Screen/refine ranking uses only known-validation evidence.",
    "Final test evaluation occurs once after the winning recipe is frozen.",
    "Architecture changes are excluded from this HPO space; STFT representation is a separate ablation."
  ]
}
